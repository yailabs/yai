[package]
name = "yai-application"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
name = "yai_application"
path = "src/lib.rs"

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
yai-engine = { path = "../../engine/yai-engine" }
rustls = "0.23"
webpki-roots = "1"
jsonschema = { version = "0.50.0", default-features = false }

[dev-dependencies]
rcgen = "0.13"
